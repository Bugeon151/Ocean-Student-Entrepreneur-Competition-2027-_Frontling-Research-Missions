{
  "validation_version": "1.0.0",
  "rounding": "Compare unrounded student value to unrounded reference; VALID if |x - ref| <= tolerance. Values must have >= min_decimals decimals.",
  "tasks": [
    {
      "id": "r1-pct-1959-1971",
      "stage": "reproduce",
      "label": "CO₂ rise 1959→1971 (%)",
      "prompt": "By what percentage did the annual mean CO₂ rise from 1959 to 1971?",
      "unit": "%",
      "dataset": "reproduce",
      "compute": {
        "op": "pct_change",
        "from": 1959,
        "to": 1971
      },
      "tolerance": 0.02,
      "min_decimals": 2,
      "method": [
        {
          "key": "base",
          "label": "Base (denominator) year",
          "type": "number",
          "expected": "1959"
        },
        {
          "key": "unit",
          "label": "Unit of your result",
          "type": "select",
          "options": [
            "% of the 1959 value",
            "ppm"
          ],
          "expected": "% of the 1959 value"
        }
      ],
      "signatures": [
        {
          "code": "PUBLISHED_VALUE",
          "value": 3.4
        },
        {
          "code": "WRONG_BASE",
          "value": 3.168669
        },
        {
          "code": "RATIO_NOT_PERCENT",
          "value": 1.032724
        },
        {
          "code": "PPM_DIFFERENCE",
          "value": 10.34
        },
        {
          "code": "SIGN_FLIP",
          "value": -3.272359
        }
      ],
      "published": {
        "value": 3.4,
        "text": "Keeling et al. (1976): annual average CO₂ rose 3.4% between 1959 and 1971",
        "url": "https://doi.org/10.3402/tellusa.v28i6.11322"
      },
      "expected": 3.272359
    },
    {
