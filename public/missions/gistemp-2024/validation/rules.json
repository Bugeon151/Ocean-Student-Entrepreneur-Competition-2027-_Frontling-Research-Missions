{
  "validation_version": "1.0.0",
  "rounding": "Compare unrounded student value to unrounded reference; VALID if |x - ref| <= tolerance. Values must have >= min_decimals decimals.",
  "tasks": [
    {
      "id": "r1-annual-2024",
      "stage": "reproduce",
      "label": "2024 global annual mean anomaly",
      "prompt": "What was the 2024 annual mean anomaly in °C (relative to 1951–1980)?",
      "unit": "°C",
      "dataset": "reproduce",
      "compute": {
        "op": "annual_mean",
        "year": 2024
      },
      "tolerance": 0.006,
      "min_decimals": 2,
      "method": [
        {
          "key": "unit",
          "label": "Unit of your result",
          "type": "select",
          "options": [
            "°C",
            "°F"
          ],
          "expected": "°C"
        },
        {
          "key": "months",
          "label": "Months averaged",
          "type": "select",
          "options": [
            "January–December 2024 (12 months)",
            "December 2023–November 2024",
            "Fewer than 12 months"
          ],
          "expected": "January–December 2024 (12 months)"
        }
      ],
      "signatures": [
        {
          "code": "FAHRENHEIT",
          "value": 2.307001
        },
        {
          "code": "FAHRENHEIT_ABSOLUTE",
          "value": 34.307001
        },
        {
          "code": "SUM_NOT_MEAN",
          "value": 15.380004
        },
        {
          "code": "DECIMAL_SHIFT",
          "value": 12.81667
        },
        {
          "code": "WRONG_YEAR",
          "value": 1.1675
        },
        {
          "code": "SIGN_FLIP",
          "value": -1.281667
        }
      ],
      "published": {
        "value": 1.28,
        "text": "NASA: 2024 was 1.28 °C above the 1951–1980 baseline",
        "url": "https://science.nasa.gov/earth/explore/earth-indicators/global-temperature/"
      },
      "expected": 1.281667
    },
    {
      "id": "r2-trend-1975-2024",
